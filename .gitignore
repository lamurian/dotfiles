# Blacklist everything
*

# Whitelist directories (allows traversal into packages)
!*/

# Root files
!.gitignore
!.gitmodules
!README.md
!bootstrap.sh

# common
!common/.config/**
!common/.irssi/**
!common/.newsboat/**
!common/.w3m/**
!common/.gnupg/**
!common/.agents/**
!common/.pi/**
!common/bin/**

# darwin
!darwin/.zshrc
!darwin/.zprofile

# linux
!linux/.bashrc
!linux/.Xresources
!linux/.xinitrc

# work
!work/.tmux.conf
!work/.vimrc
!work/.vim/**
!work/.pandoc/**
!work/.Rprofile

# --- Blacklist cruft ---
**/.DS_Store
**/node_modules/

# work
work/.vim/plugged/

# common
common/.config/goose/mcp-hermit/
common/.config/opencode/node_modules/
common/.config/chromium/
common/.config/i3/start.log
common/.config/ncmpcpp/error.log

# root (leftover from old layout)
.local
R
